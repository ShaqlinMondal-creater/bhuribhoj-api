{
  "info": {
    "name": "BhuriBhoj API",
    "description": "Every BhuriBhoj API with a sample body.\n\n1. Import this file in Postman.\n2. Send Auth → Login. The token is saved on the collection automatically.\n3. Other requests send Authorization: Bearer {{token}}.\n\nbase_url defaults to the local API (http://127.0.0.1:8000/api). Change the collection variable for live: https://bhuribhoj-api.liwaas.com/api\n\nList fetches are POST. Filters go in the JSON body, not the query string.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "9"
    },
    {
      "key": "record_id",
      "value": "1"
    },
    {
      "key": "invitation_token",
      "value": "paste-invitation-token"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Login saves the bearer token onto the collection.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Practice seats: president@paulmess.local / President@123, manager@paulmess.local / Manager@123, member@paulmess.local / Member@123, admin@bhuribhoj.local / Admin@123.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"president@paulmess.local\",\n  \"password\": \"President@123\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('Saved token for the rest of the collection.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/me",
            "description": "Current user. Avatar is included here and hidden on member lists."
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/profile",
            "description": "Password is optional. When set, password_confirmation is required. Avatar is a data URL: data:image/jpeg;base64,...",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Paul President\",\n  \"mobile\": \"9000000001\",\n  \"password\": \"\",\n  \"password_confirmation\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/logout",
            "description": "Revokes the current token.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },

    },
    {
      "name": "Mess invitations",
      "description": "Token routes are public. Fetch, create, and cancel are admin only.",
      "item": [
        {
          "name": "Fetch by token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/mess-invitations/token/{{invitation_token}}/fetch",
            "description": "Look up a pending invitation before the president accepts it.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Accept invitation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/mess-invitations/token/{{invitation_token}}/accept",
            "description": "Creates the mess and the president, then returns a token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mess\": {\n    \"name\": \"Invited Mess\",\n    \"address\": \"12 College Road\",\n    \"district\": \"Kolkata\",\n    \"pincode\": \"700001\",\n    \"contact_no\": \"9800000000\",\n    \"email\": \"invited@example.com\",\n    \"fund_mode\": \"manager_only\"\n  },\n  \"president\": {\n    \"name\": \"Invited President\",\n    \"password\": \"President@123\",\n    \"mobile\": \"9800000002\",\n    \"room_no\": \"P1\"\n  },\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Fetch invitations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/mess-invitations/fetch?page=1",
            "description": "Admin. Laravel page is a query param.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create invitation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/mess-invitations/create",
            "description": "Admin. expires_in_days is 1–30 and defaults to 7.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_id\": 1,\n  \"email\": \"newpresident@example.com\",\n  \"mobile\": \"9800000099\",\n  \"mess_name\": \"Future Mess\",\n  \"expires_in_days\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cancel invitation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/mess-invitations/{{record_id}}/cancel",
            "description": "Admin. Only a pending invitation can be cancelled."
          }
        }
      ]
    },
